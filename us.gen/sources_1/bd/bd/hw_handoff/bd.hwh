    <MODULE COREREVISION="9" FULLNAME="/jesd_coreclk_buf" HWVERSION="2.2" INSTANCE="jesd_coreclk_buf" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="util_ds_buf" VLNV="xilinx.com:ip:util_ds_buf:2.2">
