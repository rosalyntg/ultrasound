    <MODULE COREREVISION="7" FULLNAME="/mdm_1" HWVERSION="1.0" INSTANCE="mdm_1" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="mdm_riscv" VLNV="xilinx.com:ip:mdm_riscv:1.0">
