// MODULE VLNV: amd.com:blockdesign:bd:1.0

// The following must be inserted into your System Verilog file for this
// module to be instantiated. Change the instance name, port and interface connections
// (in parentheses) to your own signal names.

// IMPORTANT: Please check the generated 'bd_sv.sv' wrapper file is also included in the project.
//            This file can be found in the .gen folder of the respective IP or Block Design after
//            running the generate output products step.

// INCLUDE_TAG     ------ Begin cut for INTERFACE INSTANTIATION Include ------
`include "vivado_interfaces.svh"
// INCLUDE_TAG_END ------  End cut for INTERFACE INSTANTIATION Include  ------

// INTF_TAG     ------ Begin cut for INTERFACE INSTANTIATION Template ------

// INTF_TAG_END ------  End cut for INTERFACE INSTANTIATION Template  ------

// INST_TAG     ------ Begin cut for WRAPPER INSTANTIATION Template ------
bd_sv your_instance_name (
  .eth_refclk_clk_n(eth_refclk_clk_n), // input wire eth_refclk_clk_n
  .eth_refclk_clk_p(eth_refclk_clk_p), // input wire eth_refclk_clk_p
  .sfp_rx_gt_port_0_n(sfp_rx_gt_port_0_n), // input wire sfp_rx_gt_port_0_n
  .sfp_rx_gt_port_0_p(sfp_rx_gt_port_0_p), // input wire sfp_rx_gt_port_0_p
  .sfp_tx_gt_port_0_n(sfp_tx_gt_port_0_n), // output wire sfp_tx_gt_port_0_n
  .sfp_tx_gt_port_0_p(sfp_tx_gt_port_0_p), // output wire sfp_tx_gt_port_0_p
  .jesd_refclk_clk_n(jesd_refclk_clk_n), // input wire [0:0] jesd_refclk_clk_n
  .jesd_refclk_clk_p(jesd_refclk_clk_p), // input wire [0:0] jesd_refclk_clk_p
  .osc_200mhz_clk_n(osc_200mhz_clk_n), // input wire osc_200mhz_clk_n
  .osc_200mhz_clk_p(osc_200mhz_clk_p), // input wire osc_200mhz_clk_p
  .jesd_coreclk_clk_n(jesd_coreclk_clk_n), // input wire [0:0] jesd_coreclk_clk_n
  .jesd_coreclk_clk_p(jesd_coreclk_clk_p), // input wire [0:0] jesd_coreclk_clk_p
  .sfp_i2c_scl_i(sfp_i2c_scl_i), // input wire sfp_i2c_scl_i
  .sfp_i2c_scl_o(sfp_i2c_scl_o), // output wire sfp_i2c_scl_o
  .sfp_i2c_scl_t(sfp_i2c_scl_t), // output wire sfp_i2c_scl_t
  .sfp_i2c_sda_i(sfp_i2c_sda_i), // input wire sfp_i2c_sda_i
  .sfp_i2c_sda_o(sfp_i2c_sda_o), // output wire sfp_i2c_sda_o
  .sfp_i2c_sda_t(sfp_i2c_sda_t), // output wire sfp_i2c_sda_t
  .jesd_rxp(jesd_rxp), // input wire [3:0] jesd_rxp
  .jesd_rxn(jesd_rxn), // input wire [3:0] jesd_rxn
  .sfp_mod_abs(sfp_mod_abs), // input wire [0:0] sfp_mod_abs
  .led(led) // output wire [1:0] led
);
