	(text "Assuming 4x muxes\n\nPower Tree:\n12V: 3.27A + FPGA\n    3.3V: 1645mA (0.5A @ 12V)\n        SFP OSC: 61mA\n        CLK: 80mA\n        PULSER0: 1mA\n        PULSER1: 1mA\n        SFP: 1500mA\n        MUX0: 1mA\n    2.5V: 564mA (0.12A @ 12V)\n        A1V8: 466mA\n            ADC0: 233mA\n            ADC1: 233mA\n        1V8: 78mA\n            ADC0: 39mA\n            ADC1: 39mA\n        PWR LED: 20mA\n    -10V: 36mA (50mA @ 12V)\n        PULSER0: 14mA\n        PULSER1: 14mA\n        -5V: 8mA\n            MUX0: 2mA/each\n    10V: 578mA (600mA @ 12V)\n        PULSER0: 4mA\n        PULSER1: 4mA\n        A5V: 552mA\n            VGA0: 276mA\n            VGA1: 276mA\n        5V: 18mA\n            PULSER0: 1mA\n            PULSER1: 1mA\n            MUX: 4mA/each\n    +HV: 0.5A @ 12V\n    -HV: 0.5A @ 12V\n    FPGA: ???? (1A @ 12V)"
		(exclude_from_sim no)
		(at 246.126 86.36 0)
